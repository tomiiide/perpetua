{
  "name": "@perpkit/venues",
  "version": "0.0.0",
  "description": "Venue implementations against @perpkit/core's contract: mock, hyperliquid, pod, binance.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomiiide/perpetua.git",
    "directory": "packages/venues"
  },
  "homepage": "https://github.com/tomiiide/perpetua#readme",
  "bugs": "https://github.com/tomiiide/perpetua/issues",
  "keywords": [
    "perpetuals",
    "trading",
    "perps",
    "hyperliquid",
    "defi",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./hyperliquid": {
      "types": "./dist/hyperliquid/index.d.ts",
      "import": "./dist/hyperliquid/index.js"
    },
    "./binance": {
      "types": "./dist/binance/index.d.ts",
      "import": "./dist/binance/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@perpkit/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.22.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
